# Install as /etc/vpn-maintenance.env with owner root:root and mode 600.

# Cloudflare DDNS settings. Use a dedicated API token scoped to this zone.
CF_DDNS_API_TOKEN="replace-with-ddns-api-token"
CF_ZONE_ID="replace-with-32-character-zone-id"
CF_RECORD_NAME="vpn.example.com"
CF_TTL="1"
CF_IP_CHECK_URL="https://cloudflare.com/cdn-cgi/trace"

# Let's Encrypt settings. The Cloudflare credentials file should use a
# different API token from CF_DDNS_API_TOKEN.
CERT_NAME="vpn.example.com"
LE_EMAIL="admin@example.com"
CF_DNS_CREDENTIALS_FILE="/etc/letsencrypt/cloudflare-acme.ini"
CERTBOT_BIN="/usr/bin/certbot"
LE_CONFIG_DIR="/etc/letsencrypt"
