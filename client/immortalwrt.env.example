# Managed by vpn-node-maintenance: immortalwrt-deploy.sh (example)
#
# Copy to the path referenced by IMMORTALWRT_DEPLOY_CONFIG
# (default /etc/vpn-node/immortalwrt.env), then restrict it:
#
#   install -d -m 0700 /etc/vpn-node
#   install -m 0600 client/immortalwrt.env.example /etc/vpn-node/immortalwrt.env
#   chown root:root /etc/vpn-node/immortalwrt.env
#
# The file must be a regular, root-owned file with mode 0400 or 0600.
#
# The WAN and LAN physical network interfaces are NOT set here: they are always
# chosen interactively during `immortalwrt-deploy.sh install`.

# ---- LAN ----

# Router LAN address in CIDR form. Installing moves the admin address here, so
# reconnect to this IP afterwards. IPv6 RA / DHCPv6 are disabled on the LAN.
LAN_ADDRESS="10.192.0.1/24"

# ---- WAN (DHCP always; PPPoE optional) ----

# PPPoE credentials. Leave BOTH empty for a DHCP-only WAN. When set, a PPPoE
# logical interface is created on the same physical WAN device with the lower
# (preferred) metric, and a DHCP logical interface is kept as a higher-metric
# fallback. The installer never waits for or verifies WAN connectivity.
PPPOE_USERNAME=""
PPPOE_PASSWORD=""

# Route metrics. PPPOE_METRIC must be lower than DHCP_METRIC so PPPoE wins the
# default route while DHCP stays as fallback.
PPPOE_METRIC="10"
DHCP_METRIC="20"

# ---- WireGuard ----

# Two WireGuard interfaces listen on different UDP ports and IPv4 subnets.
# wg-global is intended for forced global proxying; wg-local for GFWList split
# routing (routing itself is configured in a later step). Inner traffic is
# IPv4-only; the outer transport is reached over IPv6 only.
WG_GLOBAL_ADDRESS="10.192.100.1/24"
WG_GLOBAL_PORT="51820"
WG_LOCAL_ADDRESS="10.192.200.1/24"
WG_LOCAL_PORT="51821"

# Tunnel MTU (1280-1500). 1380 leaves headroom for the IPv6 outer header.
WG_MTU="1380"

# Optional home endpoint host baked into generated client templates. Leave
# empty to emit a placeholder you edit later. Set to your home public IPv6 or
# DDNS domain. IPv6 literals (containing a colon) are bracketed automatically
# in the template; hostnames, DDNS domains, and IPv4 literals are left as-is.
WG_ENDPOINT_HOST=""

# WireGuard peers, one string per array element, whitespace-separated
# key=value tokens:
#
#   name=<label>            (required) unique peer name; names the section/file
#   address=<ipv4>          (required) inner tunnel IPv4 (a /32 is derived)
#   public_key=<base64>     (optional) the peer's public key. If omitted, the
#                           installer generates a key pair, persists it, and
#                           writes the private key into the client template.
#   preshared_key=<base64>  (optional) symmetric preshared key
#   keepalive=<seconds>     (optional) PersistentKeepalive (default 25)
#
# Peer inner addresses must be unique within an interface. Each server-side
# peer gets a /32 AllowedIPs; clients get AllowedIPs=0.0.0.0/0.
#
# Example:
# WG_GLOBAL_PEERS=(
#   "name=phone address=10.192.100.2"
#   "name=laptop address=10.192.100.3 public_key=REPLACE_WITH_CLIENT_PUBLIC_KEY"
# )
# WG_LOCAL_PEERS=(
#   "name=console address=10.192.200.2"
# )
WG_GLOBAL_PEERS=()
WG_LOCAL_PEERS=()

# ==========================================================================
# sing-box proxy nodes (HomeProxy)
# ==========================================================================
#
# These values are produced by the server deployer (server/sing-box-deploy.sh)
# in its root-only client-parameters file /etc/vpn-node/sing-box-client.env.
# Copy them here. The server field names differ slightly; the mapping is:
#
#   server sing-box-client.env   ->  this file
#   --------------------------------------------------
#   SERVER_IPV4                  ->  VPS_IPV4
#   HY2_PORT                     ->  HY2_PORT
#   HY2_PORTS                    ->  HY2_PORTS
#   HY2_PASSWORD                 ->  HY2_PASSWORD
#   SALAMANDER_PASSWORD          ->  HY2_OBFS_PASSWORD
#   HY2_SNI                      ->  HY2_SNI
#   HY2_CERT_MODE                ->  HY2_CERT_MODE
#   REALITY_PORT                 ->  REALITY_PORT
#   VLESS_UUID                   ->  REALITY_UUID
#   REALITY_PUBLIC_KEY           ->  REALITY_PUBLIC_KEY
#   REALITY_SHORT_ID             ->  REALITY_SHORT_ID
#   REALITY_SERVER_NAME          ->  REALITY_TARGET_NAME
#
# Leave VPS_IPV4 empty to install the base network + WireGuard only, with no
# HomeProxy configuration.

# Public IPv4 literal of the VPS. Dialing is IPv4-only (HomeProxy ipv6_support=0
# and dns_strategy=ipv4_only).
VPS_IPV4=""

# Hysteria2 (default high-speed link). HY2_PORT is the UDP port; HY2_PORTS is an
# optional "START:END" hopping range mirrored from the server.
HY2_PORT="443"
HY2_PORTS=""
HY2_PASSWORD=""

# Salamander obfuscation password (server SALAMANDER_PASSWORD).
HY2_OBFS_PASSWORD=""

# TLS SNI presented to the HY2 server. Defaults to VPS_IPV4 when empty.
HY2_SNI=""

# HY2 server certificate trust:
#   selfsigned  : HY2_CERT_PIN must contain the server's self-signed certificate
#                 in PEM form (the full -----BEGIN/END CERTIFICATE----- block).
#                 HomeProxy pins it with tls_self_sign + tls_cert_path; the
#                 client never uses insecure TLS.
#   letsencrypt : the server uses a public CA; HY2_CERT_PIN is unused and
#                 HY2_SNI must be the certificate domain.
HY2_CERT_MODE="selfsigned"
HY2_CERT_PIN=""

# VLESS + REALITY + Vision (manual TCP fallback link).
REALITY_PORT="443"
REALITY_UUID=""
REALITY_PUBLIC_KEY=""
REALITY_SHORT_ID=""

# REALITY TLS SNI / handshake server name (server REALITY_SERVER_NAME).
REALITY_TARGET_NAME=""

# uTLS fingerprint used by the REALITY client. REALITY requires a non-empty,
# supported fingerprint ('360' and 'android' are rejected by HomeProxy).
REALITY_FINGERPRINT="chrome"

# ==========================================================================
# Optional home IPv6 Cloudflare DDNS
# ==========================================================================
#
# When HOME_DOMAIN is set, a Cloudflare AAAA updater publishes a stable global
# IPv6 (skipping privacy/temporary addresses) as a DNS-only (grey-cloud) record,
# triggered by hotplug and a cron job. Leave HOME_DOMAIN empty to disable DDNS
# and use the current IPv6 literal directly. When set, both Cloudflare values
# are required.
HOME_DOMAIN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""

# ==========================================================================
# Public LuCI (separate IPv6-only HTTPS instance)
# ==========================================================================
#
# A dedicated uhttpd instance listens on [::]:LUCI_PUBLIC_PORT (IPv6-only),
# separate from the LAN admin instance, opened only on WAN6.
#   selfsigned  : a self-signed certificate is generated (browser warning).
#   letsencrypt : a certificate is obtained with the ACME Cloudflare DNS-01
#                 challenge; requires HOME_DOMAIN and the Cloudflare credentials.
# Set a strong, unique root password before exposing LuCI. The non-standard port
# only reduces noise; it is not a security boundary and there is no login lockout.
LUCI_PUBLIC_PORT="10443"
LUCI_CERT_MODE="selfsigned"
