# Managed by vpn-node-maintenance: immortalwrt-deploy.sh (example)
#
# Copy to the path referenced by IMMORTALWRT_DEPLOY_CONFIG
# (default /etc/vpn-node/immortalwrt.env), then restrict it:
#
#   install -d -m 0700 /etc/vpn-node
#   install -m 0600 client/immortalwrt.env.example /etc/vpn-node/immortalwrt.env
#   chown root:root /etc/vpn-node/immortalwrt.env
#
# The file must be a regular, root-owned file with mode 0400 or 0600.
#
# The WAN and LAN physical network interfaces are NOT set here: they are always
# chosen interactively during `immortalwrt-deploy.sh install`.

# ---- LAN ----

# Router LAN address in CIDR form. Installing moves the admin address here, so
# reconnect to this IP afterwards. IPv6 RA / DHCPv6 are disabled on the LAN.
LAN_ADDRESS="10.192.0.1/24"

# ---- WAN (DHCP always; PPPoE optional) ----

# PPPoE credentials. Leave BOTH empty for a DHCP-only WAN. When set, a PPPoE
# logical interface is created on the same physical WAN device with the lower
# (preferred) metric, and a DHCP logical interface is kept as a higher-metric
# fallback. The installer never waits for or verifies WAN connectivity.
PPPOE_USERNAME=""
PPPOE_PASSWORD=""

# Route metrics. PPPOE_METRIC must be lower than DHCP_METRIC so PPPoE wins the
# default route while DHCP stays as fallback.
PPPOE_METRIC="10"
DHCP_METRIC="20"

# ---- WireGuard ----

# Two WireGuard interfaces listen on different UDP ports and IPv4 subnets.
# wg-global is intended for forced global proxying; wg-local for GFWList split
# routing (routing itself is configured in a later step). Inner traffic is
# IPv4-only; the outer transport is reached over IPv6 only.
WG_GLOBAL_ADDRESS="10.192.100.1/24"
WG_GLOBAL_PORT="51820"
WG_LOCAL_ADDRESS="10.192.200.1/24"
WG_LOCAL_PORT="51821"

# Tunnel MTU (1280-1500). 1380 leaves headroom for the IPv6 outer header.
WG_MTU="1380"

# Optional home endpoint host baked into generated client templates. Leave
# empty to emit a placeholder you edit later. Set to your home public IPv6 or
# DDNS domain. IPv6 literals (containing a colon) are bracketed automatically
# in the template; hostnames, DDNS domains, and IPv4 literals are left as-is.
WG_ENDPOINT_HOST=""

# WireGuard peers, one string per array element, whitespace-separated
# key=value tokens:
#
#   name=<label>            (required) unique peer name; names the section/file
#   address=<ipv4>          (required) inner tunnel IPv4 (a /32 is derived)
#   public_key=<base64>     (optional) the peer's public key. If omitted, the
#                           installer generates a key pair, persists it, and
#                           writes the private key into the client template.
#   preshared_key=<base64>  (optional) symmetric preshared key
#   keepalive=<seconds>     (optional) PersistentKeepalive (default 25)
#
# Peer inner addresses must be unique within an interface. Each server-side
# peer gets a /32 AllowedIPs; clients get AllowedIPs=0.0.0.0/0.
#
# Example:
# WG_GLOBAL_PEERS=(
#   "name=phone address=10.192.100.2"
#   "name=laptop address=10.192.100.3 public_key=REPLACE_WITH_CLIENT_PUBLIC_KEY"
# )
# WG_LOCAL_PEERS=(
#   "name=console address=10.192.200.2"
# )
WG_GLOBAL_PEERS=()
WG_LOCAL_PEERS=()
