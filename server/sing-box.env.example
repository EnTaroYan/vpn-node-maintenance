# Managed by vpn-node-maintenance: sing-box-deploy.sh (example)
#
# Copy to the path referenced by SINGBOX_DEPLOY_CONFIG
# (default /etc/vpn-node/sing-box.env), then restrict it:
#
#   sudo install -d -m 0700 /etc/vpn-node
#   sudo install -m 0600 server/sing-box.env.example /etc/vpn-node/sing-box.env
#   sudo chown root:root /etc/vpn-node/sing-box.env
#
# The file must be a regular, root-owned file with mode 0400 or 0600.

# ---- Required ----

# Public IPv4 literal of this VPS. Used for the Hysteria2 self-signed SAN and
# as the endpoint clients connect to.
SERVER_IPV4=""

# REALITY handshake target: a real, reachable TLS site whose TLS is borrowed.
# No domain or certificate of your own is required.
REALITY_TARGET="www.microsoft.com"

# ---- Hysteria2 (default high-speed link) ----

# UDP port for the Hysteria2 listener.
HY2_PORT="443"

# Optional UDP port-hopping range "START:END". When set, an nftables DNAT
# include redirects the whole range to HY2_PORT. Empty means UDP HY2_PORT only.
HY2_PORTS=""

# letsencrypt: read an existing cert/key (never generated here).
# selfsigned : generate an RSA-3072 cert bound to SERVER_IPV4 (IP SAN), embed it
#              (base64 PEM) in the client env as HY2_CERT_PEM_B64, and print a
#              public-key pin. Clients trust the cert; never insecure=true.
HY2_CERT_MODE="selfsigned"

# For letsencrypt mode: absolute paths to the existing certificate and key.
HY2_CERT_FILE=""
HY2_KEY_FILE=""

# Optional TLS identity (SNI) presented for Hysteria2. Defaults to SERVER_IPV4.
# For letsencrypt mode set this to the certificate domain to validate against.
HY2_SNI=""

# Optional advertised bandwidth (Mbps). Leave empty to omit.
HY2_UP_MBPS=""
HY2_DOWN_MBPS=""

# ---- VLESS + REALITY + Vision (manual TCP fallback link) ----

# TCP port for the REALITY listener. May equal HY2_PORT (TCP vs UDP).
REALITY_PORT="443"

# TLS server name advertised by REALITY. Defaults to REALITY_TARGET.
REALITY_SERVER_NAME=""

# ---- Resources ----

# Optional swap file size in MB, created only when no swap is active. 0 = off.
CREATE_SWAP_MB="0"

# ---- Secrets (optional) ----
#
# Leave empty to have the installer generate strong values and persist them to
# /etc/vpn-node/sing-box-state.env (mode 0600). Persisted values are reused on
# subsequent runs so client parameters stay stable. Set explicitly only to pin
# a known value.
#
# HY2_PASSWORD=""
# SALAMANDER_PASSWORD=""
# VLESS_UUID=""
# REALITY_PRIVATE_KEY=""
# REALITY_PUBLIC_KEY=""
# REALITY_SHORT_ID=""
